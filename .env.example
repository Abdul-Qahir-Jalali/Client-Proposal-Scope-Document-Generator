# Copy to .env (never commit .env) or set these in your hosting settings. All are optional.
LOG_LEVEL=INFO          # DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=text         # text (readable) or json (for log tools)
LOG_FILE=logs/app.log   # "none" = console only
APP_ENV=development     # development, staging or production (shown in Sentry)
SENTRY_DSN=             # leave empty to keep error tracking off
